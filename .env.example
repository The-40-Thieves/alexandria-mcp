# ── Alexandria MCP — Environment Variables ──────────────────────────────────
#
# Copy this file to .env and fill in the values you need.
# Sources that require API keys will throw a clear error if the key is missing.
# Sources that don't require keys work immediately with no configuration.
#
# Required for library_ask, library_answer, and library_research (routing and
# synthesis); library_ingest also needs it for embeddings:
OPENAI_API_KEY=sk-...

# env:start
# Generated by `npm run docs`. Do not edit by hand between these markers.
#
# ── Source-specific keys ────────────────────────────────────────────────
# Each var below is read by src/sources/*.ts and gates one or more sources
# via the registry's `auth` field. A source without a key listed here works
# without any credentials.

# bhl: Biodiversity Heritage Library — natural history, botany, zoology literature. Requires free BHL_API_KEY.
BHL_API_KEY=

# ecosystems: Ecosyste.ms Packages: exact package name lookup across every open source package registry it indexes (npm, PyPI, crates.io, RubyGems, and more). Requires CONTA...
# Also read, but not required, by: openalex.
CONTACT_EMAIL=

# core: CORE: 57M+ open access research papers with full text. Broadest OA academic aggregator across all disciplines. Requires free CORE_API_KEY.
CORE_API_KEY=

# courtlistener: CourtListener: US federal and state court opinions. Free Law Project. Requires free COURTLISTENER_API_KEY (125 req/day authenticated cap since 2026-05-07).
COURTLISTENER_API_KEY=

# congress, regulations: congress.gov API v3: US federal bill search and full text. There is no /v3/search endpoint and /v3/bill's q= parameter is ignored, so search() filters the most...
DATA_GOV_API_KEY=

# dpla: Digital Public Library of America: 17M+ items from US libraries, archives, and museums. Metadata aggregator. Requires free DPLA_API_KEY.
DPLA_API_KEY=

# eia: US Energy Information Administration (EIA) API v2: energy production, consumption, and pricing series. A dotted query (e.g. "PET.MCRFPUS2.M") looks up a series...
EIA_API_KEY=

# europeana: Europeana — 50M+ cultural heritage items from European museums, libraries, and archives. Requires free EUROPEANA_API_KEY.
EUROPEANA_API_KEY=

# fred: FRED: the Federal Reserve Bank of St. Louis's economic data API, hundreds of thousands of US and international time series. Requires free FRED_API_KEY.
FRED_API_KEY=

# githubmcp, githubsearch: GitHub code search: full-text search across public repository contents. Requires GITHUB_TOKEN (the /search/code endpoint rejects unauthenticated requests).
# Also read, but not required, by: ghsa, openiti.
GITHUB_TOKEN=

# googlebooks: Google Books: 40M+ books. Full text for public domain titles; preview snippets for in-copyright works. Requires free GOOGLE_BOOKS_API_KEY (the shared keyless q...
GOOGLE_BOOKS_API_KEY=

# govinfo: GovInfo: US Congressional Record, Federal Register, US Code, Bills, CFR, and more. GPO official archive. Requires free GOVINFO_API_KEY.
GOVINFO_API_KEY=

# guardian: The Guardian Open Platform: full-text search across Guardian journalism, with article body text. Requires free GUARDIAN_API_KEY.
GUARDIAN_API_KEY=

# hapi: HDX HAPI (Humanitarian Data Exchange, Humanitarian API): conflict-event and coordination data. A country-name query resolves to a conflict-events lookup; other...
HDX_APP_IDENTIFIER=

# hud: HUD Fair Market Rents (FMR): US rental cost benchmarks by area, used to set Section 8 voucher payment standards. The query must be a 5-digit ZIP code or a 2-le...
HUD_API_TOKEN=

# nara: US National Archives (NARA): 32M+ descriptions of historical government records: war diaries, presidential papers, military records, federal agencies. Requires...
NARA_API_KEY=

# nasaads: NASA ADS — Astrophysics Data System. Premier portal for astronomy, astrophysics, and physics research. Requires NASA_ADS_API_KEY (free at ui.adsabs.harvard.edu...
NASA_ADS_API_KEY=

# newsdata: newsdata.io: real-time global news article search. Requires free NEWSDATA_API_KEY.
NEWSDATA_API_KEY=

# reliefweb: ReliefWeb: humanitarian reports and situation updates from UN OCHA and partner organizations. Requires a registered RELIEFWEB_APPNAME.
RELIEFWEB_APPNAME=

# rentcast: RentCast: US rental and sale market statistics by ZIP code. Requires free-tier RENTCAST_API_KEY (50 requests/month).
RENTCAST_API_KEY=

# smithsonian: Smithsonian Institution — 14M+ records across all museums: American history, air & space, natural history, art, military artifacts. Requires SMITHSONIAN_API_KE...
SMITHSONIAN_API_KEY=

# springer: Springer Nature — 16M+ articles via Meta API (all content, abstracts) + OA API (open access full text). Requires SPRINGER_META_API_KEY and SPRINGER_OA_API_KEY...
SPRINGER_META_API_KEY=

# tavily: Tavily: a web search API purpose-built for LLM agents and RAG pipelines, with results pre-summarized for relevance. Requires TAVILY_API_KEY; hidden without it....
TAVILY_API_KEY=

# trove: Trove (NLA Australia): 340M+ items from Australian libraries, newspapers, archives. Requires free TROVE_API_KEY. Full text is fetched only for newspaper articl...
TROVE_API_KEY=

# twelvedata: Twelve Data: stock, ETF, and forex symbol search across global exchanges, with a daily time series read. Requires free TWELVEDATA_API_KEY.
TWELVEDATA_API_KEY=

# ucdp: UCDP (Uppsala Conflict Data Program) Georeferenced Event Dataset: individually coded events of organized violence, searchable by country. Requires free UCDP_TO...
UCDP_TOKEN=

# ── Optional source keys ────────────────────────────────────────────────
# Read by the sources named below but never required by them: each only
# raises a quota, lifts a rate limit, or unlocks a better backend. Leaving
# one unset never hides a source.

# coingecko
COINGECKO_API_KEY=

# context7, context7mcp
CONTEXT7_API_KEY=

# ctext
CTEXT_API_KEY=

# digitalnz
DIGITALNZ_API_KEY=

# nvd
NVD_API_KEY=

# openalex
OPENALEX_API_KEY=

# openfda
OPENFDA_API_KEY=

# semanticscholar
SEMANTIC_SCHOLAR_API_KEY=

# springer
SPRINGER_OA_API_KEY=

# stackexchange
STACKEXCHANGE_KEY=

# youtube
SUPADATA_API_KEY=

# comtrade
UN_COMTRADE_KEY=

# youtube
YOUTUBE_API_KEY=

# zenodo
ZENODO_API_KEY=

# ── Feature envs ────────────────────────────────────────────────────────
# Routing/synthesis provider roles, caching, the web tier, MCP delegation,
# and vector storage. Every one is optional: the feature it gates is
# skipped, not failed, when absent.

# MCP transport: "stdio" (default) or "http".
TRANSPORT=

# HTTP transport port (TRANSPORT=http only).
PORT=

# Shared OpenAI-compatible gateway base URL for every role (router/synth/research/embeddings/rerank).
ALEXANDRIA_BASE_URL=

# Shared API key paired with ALEXANDRIA_BASE_URL.
ALEXANDRIA_API_KEY=

# Direct OpenAI API key. Used when no gateway is configured, and as the automatic fallback target when a configured gateway errors.
OPENAI_API_KEY=

# Per-role override: OpenAI-compatible base URL for the router role. Falls back to ALEXANDRIA_BASE_URL, then https://api.openai.com/v1.
ALEXANDRIA_ROUTER_BASE_URL=

# Per-role override: API key for the router role. Falls back to ALEXANDRIA_API_KEY, then OPENAI_API_KEY.
ALEXANDRIA_ROUTER_API_KEY=

# Per-role override: model name for the router role.
ALEXANDRIA_ROUTER_MODEL=

# Set to "1" to confirm the router role's gateway/model honors OpenAI's response_format: json_object; otherwise a JSON instruction is appended to the prompt instead.
ALEXANDRIA_ROUTER_JSON_MODE=

# Per-role override: OpenAI-compatible base URL for the synth role. Falls back to ALEXANDRIA_BASE_URL, then https://api.openai.com/v1.
ALEXANDRIA_SYNTH_BASE_URL=

# Per-role override: API key for the synth role. Falls back to ALEXANDRIA_API_KEY, then OPENAI_API_KEY.
ALEXANDRIA_SYNTH_API_KEY=

# Per-role override: model name for the synth role.
ALEXANDRIA_SYNTH_MODEL=

# Set to "1" to confirm the synth role's gateway/model honors OpenAI's response_format: json_object; otherwise a JSON instruction is appended to the prompt instead.
ALEXANDRIA_SYNTH_JSON_MODE=

# Per-role override: OpenAI-compatible base URL for the research role. Falls back to ALEXANDRIA_BASE_URL, then https://api.openai.com/v1.
ALEXANDRIA_RESEARCH_BASE_URL=

# Per-role override: API key for the research role. Falls back to ALEXANDRIA_API_KEY, then OPENAI_API_KEY.
ALEXANDRIA_RESEARCH_API_KEY=

# Per-role override: model name for the research role.
ALEXANDRIA_RESEARCH_MODEL=

# Set to "1" to confirm the research role's gateway/model honors OpenAI's response_format: json_object; otherwise a JSON instruction is appended to the prompt instead.
ALEXANDRIA_RESEARCH_JSON_MODE=

# Per-role override: OpenAI-compatible base URL for the embeddings role. Falls back to ALEXANDRIA_BASE_URL, then https://api.openai.com/v1.
ALEXANDRIA_EMBEDDINGS_BASE_URL=

# Per-role override: API key for the embeddings role. Falls back to ALEXANDRIA_API_KEY, then OPENAI_API_KEY.
ALEXANDRIA_EMBEDDINGS_API_KEY=

# Per-role override: model name for the embeddings role.
ALEXANDRIA_EMBEDDINGS_MODEL=

# Set to "1" to confirm the embeddings role's gateway/model honors OpenAI's response_format: json_object; otherwise a JSON instruction is appended to the prompt instead.
ALEXANDRIA_EMBEDDINGS_JSON_MODE=

# Per-role override: OpenAI-compatible base URL for the rerank role. Falls back to ALEXANDRIA_BASE_URL, then https://api.openai.com/v1.
ALEXANDRIA_RERANK_BASE_URL=

# Per-role override: API key for the rerank role. Falls back to ALEXANDRIA_API_KEY, then OPENAI_API_KEY.
ALEXANDRIA_RERANK_API_KEY=

# Per-role override: model name for the rerank role.
ALEXANDRIA_RERANK_MODEL=

# Set to "1" to confirm the rerank role's gateway/model honors OpenAI's response_format: json_object; otherwise a JSON instruction is appended to the prompt instead.
ALEXANDRIA_RERANK_JSON_MODE=

# Set to "llm" to rerank fused results with a chat call (the rerank role); otherwise the fused order is kept.
ALEXANDRIA_RERANK=

# Stage-1 confidence margin (0-1: top candidate score minus the score at max_sources+1, normalised by the top score) at or above which library_ask skips the LLM router call and fans out to stage 1's top max_sources directly with the raw query. Unset or invalid uses the built-in default (see docs/routing-eval.md for how it was chosen).
ALEXANDRIA_ROUTER_SKIP_MARGIN=

# Search result cache TTL in milliseconds. Unset or non-numeric uses the built-in default.
ALEXANDRIA_CACHE_TTL_MS=

# Path to the routing catalog embedding cache. Defaults to eval/catalog-embeddings.json inside the package.
ALEXANDRIA_CATALOG_CACHE=

# Path to the shared undici RFC 9111 http-cache SQLite database. Defaults to data/http-cache.db inside the package; set to ":memory:" to force the in-memory store, or falls back to it automatically if the path can't be created.
ALEXANDRIA_HTTP_CACHE=

# Path to the node:sqlite database backing the daily quota ledger and search result cache. Defaults to data/alexandria.db inside the package; set to ":memory:" to force the in-memory store, or falls back to it automatically if the path can't be created.
ALEXANDRIA_STATE_DB=

# Set to "supabase" (with SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY) to persist the daily quota ledger there instead of ALEXANDRIA_STATE_DB.
ALEXANDRIA_LEDGER=

# Test-only: lets the fetch tier SSRF guard reach 127.0.0.1/localhost. Never set in production.
ALEXANDRIA_ALLOW_LOOPBACK=

# Self-hosted SearXNG metasearch instance URL. Hides the searxng source without it.
SEARXNG_URL=

# Self-hosted crawl4ai headless-browser render server URL (fetch tier 3). Hides that tier without it.
CRAWL4AI_URL=

# Bearer token for CRAWL4AI_URL, only needed if your instance requires auth.
CRAWL4AI_API_TOKEN=

# Jina AI Reader/Search key. Required to unhide the jinasearch source; also enables fetch tier 2 (jina reader) as a fallback when set.
JINA_API_KEY=

# Set to 1 to use the jina reader fetch tier anonymously (20 RPM shared cap) when JINA_API_KEY is unset.
ALEXANDRIA_JINA_READER=

# Optional knowledge-base MCP server URL, folded into library_answer as one more ranked list.
KNOWLEDGE_MCP_URL=

# Bearer token for KNOWLEDGE_MCP_URL.
KNOWLEDGE_MCP_TOKEN=

# Supabase project URL. Required for library_ingest and for ALEXANDRIA_LEDGER=supabase.
SUPABASE_URL=

# Supabase service role key. Required for library_ingest and for ALEXANDRIA_LEDGER=supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Table name for library_ingest chunks. Default knowledge_chunks.
SUPABASE_TABLE=

# library_ingest embedding provider. Only "openai" (the default) is implemented.
EMBEDDING_PROVIDER=

# library_ingest vector store provider. Only "supabase" (the default) is implemented.
VECTOR_STORE_PROVIDER=

# Standard Node environment name. Only "test" has a special meaning here: it makes src/log.ts default to a discard destination instead of real stderr, so `npm test` (which sets this) stays quiet unless a test captures log output itself.
NODE_ENV=

# Set to any non-empty value to log extra diagnostics (also raises LOG_LEVEL to debug).
DEBUG=

# pino log level. Defaults to "debug" when DEBUG is set, otherwise "info".
LOG_LEVEL=

# Max trove full-text reads per run before falling back to metadata. Default 25.
TROVE_FULLTEXT_CAP=
# env:end
