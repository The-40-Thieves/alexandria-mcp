# ── Alexandria MCP — Environment Variables ──────────────────────────────────
#
# Copy this file to .env and fill in the values you need.
# Sources that require API keys will throw a clear error if the key is missing.
# Sources that don't require keys work immediately with no configuration.
#
# Required for library_ask (natural language search) and library_ingest:
OPENAI_API_KEY=sk-...

# Required for library_ingest (vector storage):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Optional: API Keys for specific sources ──────────────────────────────────

# Your contact email — used as a courtesy param in OpenAlex, Crossref, BASE
# to identify your requests. Any valid email works.
CONTACT_EMAIL=your-email@example.com

# CORE (core.ac.uk) — 57M+ OA papers. Free key at https://core.ac.uk/services/api
CORE_API_KEY=

# CourtListener — US case law. Free at https://www.courtlistener.com/sign-in/
# Note: Access Level 5 = 125 requests/day
COURTLISTENER_API_KEY=

# GovInfo — US Congressional Record, Federal Register (api.govinfo.gov)
# Free at https://api.govinfo.gov/docs/
GOVINFO_API_KEY=

# Zenodo — CERN open research repository. Optional; raises rate limits.
# Free at https://zenodo.org/account/settings/applications/
ZENODO_API_KEY=

# Google Books — 40M+ books. Optional; higher quota with key.
# Free at https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# BHL — Biodiversity Heritage Library natural history literature.
# Free at https://www.biodiversitylibrary.org/getapikey.aspx
BHL_API_KEY=

# DigitalNZ — New Zealand digital collections.
# Free at https://digitalnz.org/developers
DIGITALNZ_API_KEY=

# DPLA — Digital Public Library of America.
# Free at https://pro.dp.la/developers/api-codex
DPLA_API_KEY=

# Europeana — European cultural heritage (50M+ items).
# Free at https://apis.europeana.eu/
EUROPEANA_API_KEY=

# Trove — National Library of Australia digitized collections.
# Free at https://trove.nla.gov.au/about/create-something/using-api
TROVE_API_KEY=

# Semantic Scholar — 200M+ papers with AI-powered recommendations.
# Free at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# NASA ADS — Astrophysics Data System astronomy/physics portal.
# Free at https://ui.adsabs.harvard.edu/user/settings/token
NASA_ADS_API_KEY=

# Smithsonian — 14M+ records across all Smithsonian museums.
# Free key from https://api.data.gov/signup/ (same key works for GovInfo)
SMITHSONIAN_API_KEY=

# Springer Nature — Open Access API for OA articles
# Free at https://dev.springernature.com/
SPRINGER_OA_API_KEY=

# Springer Nature — Meta API for all 16M+ Springer articles (broader coverage)
# Free at https://dev.springernature.com/
SPRINGER_META_API_KEY=

# BASE — Bielefeld Academic Search Engine (400M+ records).
# Requires IP whitelisting — register at https://www.base-search.net/about/en/contact.php
BASE_API_KEY=

# YouTube Data API v3 — search only; transcripts use no quota.
# Free at https://console.cloud.google.com/ (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# GitHub Token — Required for OpenITI (Islamicate texts via GitHub code search).
# Create at https://github.com/settings/tokens (no special scopes needed)
GITHUB_TOKEN=

# ── Transport ────────────────────────────────────────────────────────────────
# stdio (default, for Claude Desktop) or http (for self-hosting/Railway)
TRANSPORT=stdio
# HTTP port when TRANSPORT=http (Railway sets this automatically)
PORT=3000

# ── Embedding / Vector Store (for library_ingest) ───────────────────────────
# Defaults shown — override if using a different model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
VECTOR_STORE_PROVIDER=supabase
SUPABASE_TABLE=knowledge_chunks
