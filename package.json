{
  "name": "@the-40-thieves/alexandria-mcp",
  "version": "11.0.0",
  "type": "module",
  "description": "152-source digital library MCP server. Natural language search across academic papers, public domain books, legal records, government archives, and software documentation.",
  "main": "dist/index.js",
  "mcpName": "io.github.The-40-Thieves/alexandria-mcp",
  "bin": {
    "alexandria-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/sources.md",
    "docs/sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "test": "ALEXANDRIA_STATE_DB=:memory: NODE_ENV=test node --test --test-reporter=spec --test-concurrency=4 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "probe": "node scripts/probe.ts",
    "probe:baseline": "node scripts/probe.ts --baseline",
    "eval:routing": "ALEXANDRIA_STATE_DB=:memory: node scripts/eval-routing.ts",
    "eval:answer": "ALEXANDRIA_STATE_DB=:memory: node scripts/eval-answer.ts",
    "docs": "node scripts/gen-docs.ts",
    "gen:smithery-card": "node scripts/gen-smithery-card.ts",
    "publish:smithery": "node scripts/publish-smithery.ts",
    "lint": "biome check .",
    "knip": "knip",
    "gate": "npm run typecheck && npm run build && npm test && npm run lint && npm run knip",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "library",
    "research",
    "academic",
    "ai",
    "llm",
    "claude",
    "arxiv",
    "gutenberg",
    "rag"
  ],
  "author": "suavecito585",
  "license": "MIT",
  "homepage": "https://github.com/The-40-Thieves/alexandria-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-40-Thieves/alexandria-mcp.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "defuddle": "^0.19.6",
    "fast-xml-parser": "^5.11.2",
    "feedsmith": "^3.0.1",
    "linkedom": "^0.18.14",
    "node-html-parser": "^9.0.5",
    "openai": "^7.45.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "undici": "^7.30.1",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
